# Copie ce fichier en .env.local et renseigne les valeurs de ton projet Sanity
# (visibles sur https://www.sanity.io/manage)

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Utilisées par le Sanity Studio (npm run studio) — mêmes valeurs que ci-dessus
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
